# คัดลอกเป็น .env สำหรับรันในเครื่อง (อย่า commit ไฟล์ .env)
# บน Vercel ให้ใส่ค่าเหล่านี้ที่ Project Settings > Environment Variables

SECRET_KEY=change-me
# JSON ของ Firebase service account ทั้งก้อน หรือ base64 ของไฟล์ (ว่าง = ใช้ไฟล์ instance/localdb.json ในเครื่อง)
FIREBASE_CREDENTIALS=
# กุญแจเข้ารหัสเอกสารผู้ยืม (สร้างด้วย python scripts/gen_keys.py)
FILE_ENCRYPTION_KEY=
# ใช้เปิดหน้า /setup?token=... ครั้งแรก
SETUP_TOKEN=
# Vercel Cron ส่ง Authorization: Bearer <CRON_SECRET> ให้อัตโนมัติ
CRON_SECRET=
SITE_URL=https://your-app.vercel.app
# ขนาดสูงสุดต่อไฟล์ (MB) และจำนวนภาพหลักฐานต่อกิจกรรม
MAX_FILE_MB=2
MAX_EVIDENCE_IMAGES=5

# ข้อมูลติดต่อบนแถบบนสุดและ footer + ลิงก์ช่องทางติดตาม
CONTACT_EMAIL=
CONTACT_PHONE=
SOCIAL_FACEBOOK=
SOCIAL_LINE=
SOCIAL_INSTAGRAM=

# อีเมลแจ้งเตือน (ไม่บังคับ)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# โมดูลกิจกรรม (/activities) ปิดเป็นค่าเริ่มต้นตาม SRS v3 — ตั้งเป็น 1 เพื่อเปิดกลับ
ACTIVITIES_ENABLED=


# LINE Official Account (Messaging API) — เว้นว่าง = ปิดการแจ้งเตือนทาง LINE
# ใส่ค่าจริงใน Vercel > Environment Variables เท่านั้น ห้าม commit ค่าจริงลง git
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ลิงก์เพิ่มเพื่อนของ OA เช่น https://line.me/R/ti/p/@xxxxxxx
LINE_ADD_FRIEND_URL=
