rules_version = '2';
// แอปเข้าถึง Firestore ผ่าน Admin SDK ฝั่งเซิร์ฟเวอร์เท่านั้น (ข้าม rules)
// ปิดการเข้าถึงจาก client ทั้งหมด เพื่อให้การตรวจสิทธิ์อยู่ที่เซิร์ฟเวอร์ (NFR-05)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
